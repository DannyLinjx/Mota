{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mota.local/schemas/platform-pack-v1.json",
  "title": "Mota platform rule pack",
  "description": "A versioned, distributable constraint pack. Compilation is performed by mota.constraints.compiler; loaders validate this structure before handing the pack to the compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "version", "kind", "title", "purpose", "sources", "rules"],
  "properties": {
    "pack_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["manufacturing", "platform", "user"]},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "kind": {
          "enum": ["datasheet", "appnote", "engineering_spec", "library", "user"]
        },
        "url": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {"type": "boolean"},
        "layers": {"type": "array", "items": {"type": "string"}},
        "net_classes": {
          "type": "array",
          "items": {"enum": ["power", "ground", "signal"]}
        },
        "nets": {"type": "array", "items": {"type": "string"}},
        "components": {"type": "array", "items": {"type": "string"}},
        "net_scopes": {"type": "array", "items": {"type": "string"}}
      },
      "oneOf": [
        {"required": ["all"], "properties": {"all": {"const": true}}},
        {
          "required": ["layers"],
          "properties": {"all": {"const": false}}
        },
        {
          "required": ["net_classes"],
          "properties": {"all": {"const": false}}
        },
        {
          "required": ["nets"],
          "properties": {"all": {"const": false}}
        },
        {
          "required": ["components"],
          "properties": {"all": {"const": false}}
        },
        {
          "required": ["net_scopes"],
          "properties": {"all": {"const": false}}
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_layer_count": {"type": "integer", "minimum": 1},
        "max_layer_count": {"type": "integer", "minimum": 1},
        "requires_footprint": {"type": "boolean"},
        "requires_stackup": {"type": "boolean"},
        "requires_geometry": {"type": "boolean"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "kind", "selector", "parameters", "sources"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "clearance", "track_width", "via_drill", "via_outer",
            "via_annular_ring", "board_edge_clearance", "hole_clearance",
            "keepout", "impedance", "propagation_delay"
          ]
        },
        "hard": {"type": "boolean", "default": true},
        "required": {"type": "boolean", "default": true},
        "severity": {"enum": ["error", "warning", "info"]},
        "selector": {"$ref": "#/$defs/selector"},
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        },
        "precondition": {"$ref": "#/$defs/precondition"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "intent": {"type": "string"}
      }
    }
  }
}
