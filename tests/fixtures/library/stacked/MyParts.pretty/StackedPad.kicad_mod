(footprint "StackedPad" (version 20240108) (generator pcbnew)
  (layer "F.Cu")
  (descr "Two pad geometries share pad number 1")
  (attr smd)
  (pad "1" smd rect (at -1 0) (size 1 1)
    (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "1" smd rect (at -1 1.5) (size 1 1)
    (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1 0) (size 1 1)
    (layers "F.Cu" "F.Paste" "F.Mask"))
)
