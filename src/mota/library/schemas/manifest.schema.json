{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mota.example/contracts/v1/manifest.schema.json",
  "title": "MoTA immutable asset manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/asset_id"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/kind"
    },
    "namespace": {
      "$ref": "common.schema.json#/$defs/namespace"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "package_version": {
      "$ref": "common.schema.json#/$defs/package_version"
    },
    "package_mode": {
      "enum": [
        "metadata_only",
        "asset"
      ]
    },
    "origin": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider_id",
        "source_id",
        "source_version"
      ],
      "additionalProperties": false
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "documentation": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "common.schema.json#/$defs/documentation_level"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "level",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "expression": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        }
      },
      "required": [
        "expression",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "expression": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/relative_path"
          },
          "role": {
            "enum": [
              "readme",
              "usage",
              "parameters",
              "pins",
              "bindings",
              "rules",
              "symbol_geometry",
              "footprint_geometry",
              "model3d_geometry",
              "module_definition",
              "template_definition",
              "native_source",
              "preview",
              "license",
              "provenance",
              "other"
            ]
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        },
        "required": [
          "path",
          "role",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/exact_ref"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "kind",
    "namespace",
    "display_name",
    "summary",
    "category",
    "tags",
    "package_version",
    "package_mode",
    "origin",
    "legacy_ids",
    "documentation",
    "license",
    "sources",
    "files",
    "dependencies"
  ],
  "additionalProperties": false
}
