{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mota.example/contracts/v1/project-lock.schema.json",
  "title": "MoTA project asset lock and vendored dependency closure v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lock_revision": {
      "type": "integer",
      "minimum": 1
    },
    "closure_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "$ref": "common.schema.json#/$defs/asset_id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/package_version"
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "vendored_path": {
            "$ref": "common.schema.json#/$defs/relative_path"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/exact_ref"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "asset_id",
          "version",
          "digest",
          "vendored_path",
          "dependencies"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "digest": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "asset_id",
          "version",
          "digest",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "instance_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "component_ref": {
            "$ref": "common.schema.json#/$defs/exact_ref"
          },
          "binding": {
            "$ref": "bindings.schema.json#/$defs/binding"
          }
        },
        "required": [
          "instance_id",
          "component_ref",
          "binding"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "lock_revision",
    "closure_status",
    "assets",
    "unresolved",
    "instance_bindings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "closure_status": {
            "const": "complete"
          }
        },
        "required": [
          "closure_status"
        ]
      },
      "then": {
        "properties": {
          "unresolved": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
