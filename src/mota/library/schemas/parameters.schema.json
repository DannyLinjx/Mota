{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mota.example/contracts/v1/parameters.schema.json",
  "title": "MoTA sourced and typed parameters v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/asset_id"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "recommended_operating",
              "absolute_maximum",
              "nominal",
              "physical",
              "design_rule"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "nominal": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "min_inclusive": {
                    "type": "boolean"
                  },
                  "max_inclusive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              }
            ]
          },
          "units": {
            "type": [
              "string",
              "null"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            }
          },
          "status": {
            "$ref": "common.schema.json#/$defs/knowledge_status"
          }
        },
        "required": [
          "key",
          "label",
          "classification",
          "value",
          "units",
          "conditions",
          "applies_to",
          "evidence_refs",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unknown"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "source_reported"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "not": {
                    "type": "null"
                  }
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "conflict"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "parameters"
  ],
  "additionalProperties": false
}
