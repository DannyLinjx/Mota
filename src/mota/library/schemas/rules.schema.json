{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mota.example/contracts/v1/rules.schema.json",
  "title": "MoTA declarative non-executable rule records v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/asset_id"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "connect_terminals",
              "no_connect",
              "require_decoupling",
              "parameter_in_range",
              "placement_distance"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_ref"
            },
            "minItems": 1
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "rule_id",
          "type",
          "severity",
          "message",
          "applies_to",
          "evidence_refs",
          "parameters"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "connect_terminals"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "terminal_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 2,
                      "uniqueItems": true
                    },
                    "net_role": {
                      "enum": [
                        "power",
                        "ground",
                        "signal"
                      ]
                    }
                  },
                  "required": [
                    "terminal_ids",
                    "net_role"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "no_connect"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "terminal_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "terminal_ids"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "require_decoupling"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "power_terminal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "return_terminal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "capacitance_F": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max_distance_mm": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "power_terminal_id",
                    "return_terminal_id",
                    "capacitance_F",
                    "max_distance_mm"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "parameter_in_range"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "parameter_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "min": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "max": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "units": {
                      "type": "string",
                      "minLength": 1
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "parameter_key",
                    "min",
                    "max",
                    "units",
                    "conditions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "placement_distance"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "target_role": {
                      "enum": [
                        "decoupling_capacitor",
                        "crystal",
                        "series_resistor",
                        "connector"
                      ]
                    },
                    "reference_terminal_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "max_distance_mm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "target_role",
                    "reference_terminal_id",
                    "max_distance_mm"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "rules"
  ],
  "additionalProperties": false
}
